APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Criptografa o PAYLOAD da sessão antes de gravar na tabela `sessions`.
# Defesa em profundidade: se alguém ler a tabela (dump de backup vazado, acesso
# indevido ao banco), não lê o conteúdo da sessão. Custa um pouco de CPU por
# requisição. ⚠️ Ligar/desligar INVALIDA as sessões existentes — todo mundo
# precisa entrar de novo uma vez.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ┌─ E-MAIL ────────────────────────────────────────────────────────────────────┐
# DESENVOLVIMENTO: o container `mailpit` do docker-compose é um SMTP de mentira —
# aceita tudo, não entrega a ninguém e mostra as mensagens em
#   http://localhost:8026        (8026 e não 8025: outro projeto da máquina usa a 8025)
#
# SMTP em dev é DE PROPÓSITO, e não `log`. Com `log`, App\Support\Mailer::entrega()
# fica falso e o app DESVIA para os caminhos de "fase de testes": o cadastro marca o
# e-mail como verificado no ato, a troca de e-mail vale sem confirmação e "esqueci a
# senha" avisa que não dá. São caminhos legítimos — mas não são os que vão rodar em
# produção, e com `log` eles seriam os únicos jamais exercitados em dev.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@stabilmoney.com.br"
MAIL_FROM_NAME="${APP_NAME}"
#
# ── PRODUÇÃO ──────────────────────────────────────────────────────────────────
# Trocar SÓ as linhas de host/porta/usuário/senha. Nenhuma linha de código muda:
# o app decide sozinho pelo App\Support\Mailer::entrega().
#
# O que passa a valer no instante em que o mailer entrega de verdade:
#   • recuperação de senha (com `log`, ela avisa que não dá e não envia nada);
#   • verificação de e-mail no cadastro — usuário novo nasce PENDENTE e as rotas do
#     app ficam bloqueadas para ele até clicar no link (middleware `verified`);
#   • confirmação da troca de e-mail no endereço NOVO (o login continua pelo antigo
#     até o link ser clicado).
#
# ⚠️ A PORTA DECIDE O MAIL_SCHEME, e errar isso dá "connection reset" sem explicação:
#     porta 465 → MAIL_SCHEME=smtps   (TLS implícito: a conexão já nasce cifrada)
#     porta 587 → MAIL_SCHEME=smtp    (STARTTLS: começa em claro e sobe para TLS)
#   Com `smtp` numa porta 465 o cliente fala texto puro com um servidor que só entende
#   TLS, e a conexão morre antes de qualquer mensagem de erro útil.
#
# Opção A — caixa do próprio domínio, em hospedagem cPanel/Exim (é o caso deste
# projeto: `victor.jwsolucoesdigitais.com.br`). Não precisa de conta em provedor
# nenhum e o remetente já é de um domínio que você controla.
#   MAIL_HOST=<servidor de saída que o painel informa>
#   MAIL_PORT=465
#   MAIL_SCHEME=smtps
#   MAIL_USERNAME=<a caixa inteira, com @dominio>
#   MAIL_PASSWORD=<a senha da conta de e-mail>
#   MAIL_FROM_ADDRESS="<o MESMO endereço do MAIL_USERNAME>"
#
# Opção B — Gmail. Útil como plano B, ~500 envios/dia. Exige "Senha de app" na Conta
# Google (Segurança › Senhas de app; requer 2FA ligado lá).
#   MAIL_HOST=smtp.gmail.com   MAIL_PORT=587   MAIL_SCHEME=smtp
#   MAIL_FROM_ADDRESS precisa ser o próprio endereço Gmail — ele recusa outro remetente.
#
# Opção C — provedor transacional (Resend, Brevo, Mailgun, Amazon SES). Melhor
# entregabilidade e relatório de entrega, mas exige DOMÍNIO VERIFICADO (SPF/DKIM).
# É para onde migrar quando o cadastro abrir para desconhecidos.
#
# ⚠️ MAIL_FROM_ADDRESS tem de ser um endereço que você controla. Domínio alheio (ou
# inventado) cai em spam ou é recusado na cara do servidor por SPF/DKIM.
# └─────────────────────────────────────────────────────────────────────────────┘

# ┌─ Painel administrativo (routes/admin.php) ──────────────────────────────────┐
# Desligado por padrão: com `false`, TODA rota do painel responde 404 (nem tela de
# login existe). Ligue só quando for usar e desligue depois.
#   ADMIN_PANEL_ENABLED=false
# Caminho base do painel. Não é segurança (URL secreta não protege nada), só tira o
# painel do que os scanners testam primeiro.
#   ADMIN_PANEL_PATH=painel_admin
# Para onde vão os alertas de login no painel, banimento e exclusão. Vazio = e-mail do
# próprio admin que agiu. O admin é criado só por shell: `php artisan admin:criar`.
#   ADMIN_ALERT_EMAIL=
# └─────────────────────────────────────────────────────────────────────────────┘

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Usuario principal do seeder (apenas ambiente local; nunca commitar a senha real)
# SEED_USER_NAME=Victor
# SEED_USER_EMAIL=victor@stabilmoney.test
# SEED_USER_PASSWORD=
