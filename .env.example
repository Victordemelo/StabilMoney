APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Criptografa o PAYLOAD da sessão antes de gravar na tabela `sessions`.
# Defesa em profundidade: se alguém ler a tabela (dump de backup vazado, acesso
# indevido ao banco), não lê o conteúdo da sessão. Custa um pouco de CPU por
# requisição. ⚠️ Ligar/desligar INVALIDA as sessões existentes — todo mundo
# precisa entrar de novo uma vez.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ┌─ E-MAIL ────────────────────────────────────────────────────────────────────┐
# `log` NÃO entrega nada: o Laravel escreve o e-mail em storage/logs e ninguém
# recebe. Enquanto estiver assim, o app se adapta em vez de mentir (ver
# App\Support\Mailer): "esqueci a senha" avisa que não dá para enviar, e a
# verificação de e-mail não é exigida de ninguém.
#
# O que DEPENDE de um mailer de verdade para funcionar:
#   • recuperação de senha (hoje: bloqueada);
#   • verificação de e-mail no cadastro;
#   • confirmação da troca de e-mail no endereço NOVO.
#
# Para ligar, troque MAIL_MAILER para `smtp` e preencha host/porta/usuário/senha
# do provedor (Resend, Brevo, Amazon SES, Mailgun…). Nada mais precisa mudar no
# código — os três fluxos acima passam a valer sozinhos.
# MAIL_FROM_ADDRESS precisa ser de um domínio que você controla, senão o e-mail
# cai em spam ou é recusado (SPF/DKIM).
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@stabilmoney.com.br"
MAIL_FROM_NAME="${APP_NAME}"
# └─────────────────────────────────────────────────────────────────────────────┘

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Usuario principal do seeder (apenas ambiente local; nunca commitar a senha real)
# SEED_USER_NAME=Victor
# SEED_USER_EMAIL=victor@stabilmoney.test
# SEED_USER_PASSWORD=
